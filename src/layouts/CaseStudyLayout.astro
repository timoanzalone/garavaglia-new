---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  lang?: 'it' | 'en';
}

const { title, lang = 'it' } = Astro.props;
---

<Layout title={`${title} - Garavaglia`} lang={lang}>
  <Header lang={lang} />
  <main class="pt-[72px]">
    <slot />
  </main>
  <Footer lang={lang} />
</Layout>
