---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Locale } from '../i18n';

interface Props {
  title: string;
  lang?: Locale;
  heading?: string;
}

const { title, lang = 'it', heading = title } = Astro.props;
const note = t(lang).stubNote;
---

<Layout title={`${heading} - Garavaglia`} lang={lang}>
  <Header lang={lang} />
  <main class="min-h-[50vh] py-20">
    <div class="max-w-[800px] mx-auto px-5">
      <h1 class="font-heading text-4xl text-[#222] mb-4">{heading}</h1>
      <p class="text-[#666]">{note}</p>
      <slot />
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
