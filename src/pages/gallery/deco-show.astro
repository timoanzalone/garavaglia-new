---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GalleryPage from '../../components/GalleryPage.astro';
import { getGallery } from '../../lib/content';

const entry = await getGallery('deco-show', 'it');
if (!entry) throw new Error('Missing galleries/it/deco-show content');
---

<Layout title={entry.data.metaTitle ?? entry.data.title} lang="it">
  <Header lang="it" />
  <GalleryPage entry={entry} />
  <Footer lang="it" />
</Layout>
