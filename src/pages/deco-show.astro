---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AreaPage from '../components/AreaPage.astro';
import { getArea } from '../lib/content';

const entry = await getArea('deco-show', 'it');
if (!entry) throw new Error('Missing deco-show.it content');
---

<Layout title={entry.data.metaTitle} description={entry.data.metaDescription} lang="it">
  <Header lang="it" />
  <AreaPage entry={entry} />
  <Footer lang="it" />
</Layout>
