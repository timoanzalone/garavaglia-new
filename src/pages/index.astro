---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import ParallaxBanner from '../components/ParallaxBanner.astro';
import Portfolio from '../components/Portfolio.astro';
import Footer from '../components/Footer.astro';
import { areaBanners } from '../data/site';
---

<Layout title="Home - Garavaglia - Grandi scenografie e allestimenti natalizi." lang="it">
  <Header lang="it" />
  <main>
    <Hero lang="it" />
    <Intro lang="it" />

    {areaBanners.map((banner) => (
      <ParallaxBanner
        backgroundImage={banner.backgroundImage}
        backgroundPosition={banner.backgroundPosition}
        padding={banner.padding}
        logo={banner.logo}
        logoAlt={banner.logoAlt}
        logoWidth={banner.logoWidth}
        logoHeight={banner.logoHeight}
        linkUrl={banner.href.it}
      />
    ))}

    <Portfolio lang="it" />
  </main>
  <Footer lang="it" />
</Layout>
