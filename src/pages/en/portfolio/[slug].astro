---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CaseStudyPage from '../../../components/CaseStudyPage.astro';
import { getCaseStudies, getCaseStudy } from '../../../lib/content';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  const studies = await getCaseStudies('en');
  return studies.map((entry) => ({
    params: { slug: entry.data.slug },
  }));
}

const { slug } = Astro.params;
const entry = await getCaseStudy(slug!, 'en');
if (!entry) throw new Error(`Missing case study en/${slug}`);
---

<Layout
  title={entry.data.metaTitle ?? `${entry.data.title} - Garavaglia`}
  description={t('en').metaDescription}
  lang="en"
>
  <Header lang="en" />
  <CaseStudyPage entry={entry} />
  <Footer lang="en" />
</Layout>
