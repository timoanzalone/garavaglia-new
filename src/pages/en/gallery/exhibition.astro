---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import GalleryPage from '../../../components/GalleryPage.astro';
import { getGallery } from '../../../lib/content';

const entry = await getGallery('exhibition', 'en');
if (!entry) throw new Error('Missing galleries/en/exhibition content');
---

<Layout title={entry.data.metaTitle ?? entry.data.title} lang="en">
  <Header lang="en" />
  <GalleryPage entry={entry} />
  <Footer lang="en" />
</Layout>
