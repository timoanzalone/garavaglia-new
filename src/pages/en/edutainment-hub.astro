---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AreaPage from '../../components/AreaPage.astro';
import { getArea } from '../../lib/content';

const entry = await getArea('edutainment-hub', 'en');
if (!entry) throw new Error('Missing edutainment-hub.en content');
---

<Layout title={entry.data.metaTitle} description={entry.data.metaDescription} lang="en">
  <Header lang="en" />
  <AreaPage entry={entry} />
  <Footer lang="en" />
</Layout>
