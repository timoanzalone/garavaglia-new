---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Intro from '../../components/Intro.astro';
import ParallaxBanner from '../../components/ParallaxBanner.astro';
import Portfolio from '../../components/Portfolio.astro';
import Footer from '../../components/Footer.astro';
import { areaBanners } from '../../data/site';
---

<Layout
  title="Home - Garavaglia - Large scenographies and Christmas installations."
  description="Design and creation of large scenographies, theme parks, Christmas installations for shopping centers, visual marketing and trade show stands."
  lang="en"
>
  <Header lang="en" />
  <main>
    <Hero lang="en" />
    <Intro lang="en" />

    {areaBanners.map((banner) => (
      <ParallaxBanner
        backgroundImage={banner.backgroundImage}
        backgroundPosition={banner.backgroundPosition}
        padding={banner.padding}
        logo={banner.logo}
        logoAlt={banner.logoAlt}
        logoWidth={banner.logoWidth}
        logoHeight={banner.logoHeight}
        linkUrl={banner.href.en}
      />
    ))}

    <Portfolio lang="en" />
  </main>
  <Footer lang="en" />
</Layout>
