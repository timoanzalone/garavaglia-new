---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CaseStudiesPage from '../../components/CaseStudiesPage.astro';
import { getCaseStudies } from '../../lib/content';

const studies = await getCaseStudies('en');
---

<Layout
  title="Case Studies - Garavaglia - Large scenographies and Christmas installations."
  lang="en"
>
  <Header lang="en" />
  <CaseStudiesPage lang="en" studies={studies} />
  <Footer lang="en" />
</Layout>
