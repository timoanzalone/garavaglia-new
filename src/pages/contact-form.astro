---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactFormPage from '../components/ContactFormPage.astro';
import { contactFormContent } from '../data/contactForm';

const { title, metaDescription } = contactFormContent.it;
---

<Layout title={title} description={metaDescription} lang="it">
  <Header lang="it" />
  <ContactFormPage lang="it" />
  <Footer lang="it" />
</Layout>
