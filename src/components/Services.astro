---
interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const content = {
  it: {
    tagline: 'I nostri servizi',
    title: 'Soluzioni creative per ogni esigenza',
    subtitle: 'Offriamo una gamma completa di servizi per trasformare i tuoi spazi in esperienze memorabili.',
    services: [
      {
        icon: 'theater',
        title: 'Grandi Scenografie',
        description: 'Progettiamo e realizziamo scenografie di grande impatto per eventi, spettacoli, produzioni televisive e cinematografiche.',
      },
      {
        icon: 'park',
        title: 'Parchi Tematici',
        description: 'Creiamo mondi fantastici e attrazioni uniche per parchi divertimento e aree tematiche di ogni dimensione.',
      },
      {
        icon: 'christmas',
        title: 'Allestimenti Natalizi',
        description: 'Trasformiamo centri commerciali e spazi pubblici con decorazioni natalizie spettacolari e coinvolgenti.',
      },
      {
        icon: 'baby',
        title: 'Baby Parking',
        description: 'Progettiamo aree gioco sicure e stimolanti per i più piccoli, con temi creativi e materiali certificati.',
      },
      {
        icon: 'visual',
        title: 'Visual Marketing',
        description: 'Creiamo esperienze visive d\'impatto per punti vendita, vetrine e spazi espositivi che catturano l\'attenzione.',
      },
      {
        icon: 'stand',
        title: 'Stand Fieristici',
        description: 'Progettiamo stand fieristici innovativi che comunicano il valore del tuo brand e attirano visitatori.',
      },
    ],
  },
  en: {
    tagline: 'Our services',
    title: 'Creative solutions for every need',
    subtitle: 'We offer a complete range of services to transform your spaces into memorable experiences.',
    services: [
      {
        icon: 'theater',
        title: 'Large Scenographies',
        description: 'We design and create high-impact scenographies for events, shows, TV and film productions.',
      },
      {
        icon: 'park',
        title: 'Theme Parks',
        description: 'We create fantastic worlds and unique attractions for amusement parks and themed areas of all sizes.',
      },
      {
        icon: 'christmas',
        title: 'Christmas Installations',
        description: 'We transform shopping centers and public spaces with spectacular and engaging Christmas decorations.',
      },
      {
        icon: 'baby',
        title: 'Baby Parking',
        description: 'We design safe and stimulating play areas for children, with creative themes and certified materials.',
      },
      {
        icon: 'visual',
        title: 'Visual Marketing',
        description: 'We create impactful visual experiences for retail stores, windows, and exhibition spaces that capture attention.',
      },
      {
        icon: 'stand',
        title: 'Trade Show Stands',
        description: 'We design innovative trade show stands that communicate your brand value and attract visitors.',
      },
    ],
  },
};

const t = content[lang];

const icons: Record<string, string> = {
  theater: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>',
  park: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>',
  christmas: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>',
  baby: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>',
  visual: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>',
  stand: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>',
};
---

<section id={lang === 'it' ? 'servizi' : 'services'} class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-medium mb-4">
        {t.tagline}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-6">{t.title}</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">{t.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {t.services.map((service, index) => (
        <div class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-green-200 hover:-translate-y-1">
          <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-green-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[service.icon]}></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">{service.title}</h3>
          <p class="text-gray-600 leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
