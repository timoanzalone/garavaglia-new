---
interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const content = {
  it: {
    tagline: 'Chi siamo',
    title: 'Oltre 40 anni di esperienza',
    description: 'Dal 1980 Garavaglia è leader nella progettazione e realizzazione di scenografie, allestimenti e soluzioni di visual marketing. La nostra passione per la creatività e l\'attenzione ai dettagli ci hanno permesso di collaborare con i più importanti brand italiani e internazionali.',
    description2: 'Il nostro team di architetti, designer e artigiani esperti lavora a stretto contatto con ogni cliente per trasformare le idee in realtà spettacolari, rispettando tempi e budget.',
    stats: [
      { value: '40+', label: 'Anni di esperienza' },
      { value: '500+', label: 'Progetti completati' },
      { value: '100+', label: 'Clienti soddisfatti' },
      { value: '50+', label: 'Professionisti' },
    ],
    values: [
      { title: 'Creatività', description: 'Soluzioni innovative e originali per ogni progetto' },
      { title: 'Qualità', description: 'Materiali premium e lavorazioni artigianali' },
      { title: 'Affidabilità', description: 'Rispetto dei tempi e dei budget concordati' },
    ],
  },
  en: {
    tagline: 'About us',
    title: 'Over 40 years of experience',
    description: 'Since 1980, Garavaglia has been a leader in the design and creation of scenographies, installations, and visual marketing solutions. Our passion for creativity and attention to detail have allowed us to collaborate with the most important Italian and international brands.',
    description2: 'Our team of experienced architects, designers, and craftsmen works closely with each client to transform ideas into spectacular realities, while respecting timelines and budgets.',
    stats: [
      { value: '40+', label: 'Years of experience' },
      { value: '500+', label: 'Completed projects' },
      { value: '100+', label: 'Satisfied clients' },
      { value: '50+', label: 'Professionals' },
    ],
    values: [
      { title: 'Creativity', description: 'Innovative and original solutions for every project' },
      { title: 'Quality', description: 'Premium materials and artisan craftsmanship' },
      { title: 'Reliability', description: 'Respect for agreed timelines and budgets' },
    ],
  },
};

const t = content[lang];
---

<section id={lang === 'it' ? 'chi-siamo' : 'about'} class="py-24 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 text-white overflow-hidden relative">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 right-0 w-96 h-96 bg-green-500 rounded-full filter blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-72 h-72 bg-orange-500 rounded-full filter blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <span class="inline-block px-4 py-2 bg-green-500/20 text-green-400 rounded-full text-sm font-medium mb-6">
          {t.tagline}
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-8">{t.title}</h2>
        <p class="text-gray-300 text-lg leading-relaxed mb-6">{t.description}</p>
        <p class="text-gray-300 text-lg leading-relaxed mb-10">{t.description2}</p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-8">
          {t.stats.map((stat) => (
            <div>
              <div class="text-3xl sm:text-4xl font-bold text-green-400 mb-2">{stat.value}</div>
              <div class="text-gray-400 text-sm">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="space-y-6">
        {t.values.map((value, index) => (
          <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 hover:border-green-500/50 transition-colors">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-green-600 rounded-xl flex items-center justify-center flex-shrink-0">
                <span class="text-white font-bold text-xl">{index + 1}</span>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2">{value.title}</h3>
                <p class="text-gray-400">{value.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
