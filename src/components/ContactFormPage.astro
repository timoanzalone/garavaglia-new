---
/**
 * Contact form — measured from garavaglia.test/contact-form/ @ 1920, 2026-07-22
 *
 * Main (#main): pad 90px 30px 45px; row max 1280
 * IT columns: 1/6 spacer | 1/3 Contattaci | 1/3 Newsletter | 1/6 spacer (gutter ≈ 51)
 * EN columns: 1/3 spacer | 1/3 Contact us | 1/3 spacer
 *
 * Newsletter → MagNews EmailSP (apgroup 106, list 1)
 * Contact → FormSubmit.co ajax → info@garavaglia.eu
 */
import type { Lang } from '../data/site';
import { contactFormContent } from '../data/contactForm';

interface Props {
  lang?: Lang;
}

const { lang = 'it' } = Astro.props;
const c = contactFormContent[lang];
const formId = `gara-contact-form-${lang}`;
const endpoint = `https://formsubmit.co/ajax/${c.contactTo}`;
---

<main class="gara-cform">
  <div class={`gara-cform__row gara-cform__row--${c.layout}`}>
    {
      c.layout === 'it-split' ? (
        <>
          <div class="gara-cform__spacer" aria-hidden="true" />
          <div class="gara-cform__col">
            <div class="gara-cform__title-wrap">
              <h1 class="gara-cform__title">{c.contactHeading}</h1>
            </div>
            <form
              class="gara-cform__form"
              id={formId}
              data-contact-form
              data-endpoint={endpoint}
              data-sending={c.status.sending}
              data-success={c.status.success}
              data-error={c.status.error}
              novalidate
            >
              {
                c.contactFields.map((field) => (
                  <p class="gara-cform__field">
                    <label>
                      {field.label}
                      <br />
                      {field.type === 'textarea' ? (
                        <textarea
                          name={field.name}
                          rows={field.rows ?? 10}
                          required={field.required}
                        />
                      ) : (
                        <input
                          type={field.type}
                          name={field.name}
                          required={field.required}
                        />
                      )}
                    </label>
                  </p>
                ))
              }
              {/* FormSubmit honeypot */}
              <input type="text" name="_honey" class="gara-cform__honey" tabindex="-1" autocomplete="off" />
              <p class="gara-cform__field gara-cform__field--submit">
                <button class="gara-cform__submit" type="submit">{c.contactSubmit}</button>
              </p>
              <p class="gara-cform__status" hidden data-status role="status" aria-live="polite" />
            </form>
          </div>
          {
            c.newsletter && (
              <div class="gara-cform__col">
                <div class="gara-cform__title-wrap">
                  <h1 class="gara-cform__title">{c.newsletter.heading}</h1>
                </div>
                <form
                  class="gara-cform__form gara-cform__form--news"
                  action={c.newsletter.action}
                  method="post"
                  target="_blank"
                >
                  <p class="gara-cform__field">
                    <label>
                      {c.newsletter.emailLabel}
                      <br />
                      <input
                        type="email"
                        name="email"
                        placeholder={c.newsletter.emailPlaceholder}
                        required
                      />
                    </label>
                  </p>
                  <input type="hidden" name="apgroup" value={c.newsletter.apgroup} />
                  <input type="hidden" name="list" value={c.newsletter.list} />
                  <p class="gara-cform__field gara-cform__field--submit">
                    <button class="gara-cform__submit" type="submit" name="submit" value="true">
                      {c.newsletter.submit}
                    </button>
                  </p>
                </form>
              </div>
            )
          }
          <div class="gara-cform__spacer" aria-hidden="true" />
        </>
      ) : (
        <>
          <div class="gara-cform__spacer" aria-hidden="true" />
          <div class="gara-cform__col">
            <div class="gara-cform__title-wrap">
              <h1 class="gara-cform__title">{c.contactHeading}</h1>
            </div>
            <form
              class="gara-cform__form"
              id={formId}
              data-contact-form
              data-endpoint={endpoint}
              data-sending={c.status.sending}
              data-success={c.status.success}
              data-error={c.status.error}
              novalidate
            >
              {
                c.contactFields.map((field) => (
                  <p class="gara-cform__field">
                    <label>
                      {field.label}
                      <br />
                      {field.type === 'textarea' ? (
                        <textarea
                          name={field.name}
                          rows={field.rows ?? 10}
                          required={field.required}
                        />
                      ) : (
                        <input
                          type={field.type}
                          name={field.name}
                          required={field.required}
                        />
                      )}
                    </label>
                  </p>
                ))
              }
              <input type="text" name="_honey" class="gara-cform__honey" tabindex="-1" autocomplete="off" />
              <p class="gara-cform__field gara-cform__field--submit">
                <button class="gara-cform__submit" type="submit">{c.contactSubmit}</button>
              </p>
              <p class="gara-cform__status" hidden data-status role="status" aria-live="polite" />
            </form>
          </div>
          <div class="gara-cform__spacer" aria-hidden="true" />
        </>
      )
    }
  </div>
</main>

<script>
  function bindContactForm(form: HTMLFormElement) {
    if (form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const status = form.querySelector<HTMLElement>('[data-status]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const endpoint = form.dataset.endpoint;
    if (!endpoint) return;

    const setStatus = (message: string, kind: 'ok' | 'err' | 'busy') => {
      if (!status) return;
      status.hidden = false;
      status.textContent = message;
      status.dataset.kind = kind;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const name = String(data.get('your-name') || '').trim();
      const email = String(data.get('your-email') || '').trim();
      const company = String(data.get('company') || '').trim();
      const message = String(data.get('your-message') || '').trim();
      const honey = String(data.get('_honey') || '');

      if (honey) return;

      if (submit) submit.disabled = true;
      setStatus(form.dataset.sending || '…', 'busy');

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            name,
            email,
            company,
            message,
            _replyto: email,
            _subject: `Garavaglia contact — ${name}${company ? ` (${company})` : ''}`,
            _template: 'table',
            _captcha: 'false',
          }),
        });

        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const json = (await res.json().catch(() => ({}))) as { success?: string | boolean };
        if (json.success === false) throw new Error('FormSubmit rejected');

        form.reset();
        setStatus(form.dataset.success || 'OK', 'ok');
      } catch {
        setStatus(form.dataset.error || 'Error', 'err');
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }

  function boot() {
    document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(bindContactForm);
  }

  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .gara-cform {
    background: #fff;
    padding: 90px 30px 45px;
  }

  .gara-cform__row {
    display: grid;
    align-items: start;
    max-width: 1280px;
    margin: 0 auto;
    column-gap: 51px;
    row-gap: 20px;
  }

  /* IT: 1/6 + 1/3 + 1/3 + 1/6 @ 1280 → 188 / 375 / 375 / 188 */
  .gara-cform__row--it-split {
    grid-template-columns: 188fr 375fr 375fr 188fr;
  }

  /* EN: three 1/3 cols, form centered */
  .gara-cform__row--en-center {
    grid-template-columns: 1fr 1fr 1fr;
  }

  .gara-cform__title-wrap {
    margin: 0 0 30px;
  }

  .gara-cform__title {
    margin: 0;
    font-family: Raleway, Arial, Helvetica, sans-serif;
    font-size: 50px;
    font-weight: 400;
    line-height: 70px;
    color: #333;
    text-align: center;
  }

  .gara-cform__form {
    margin: 0;
  }

  .gara-cform__field {
    margin: 0 0 20px;
    font-family: 'Open Sans', Arial, Helvetica, sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 25.5px;
    color: #747474;
  }

  .gara-cform__field label {
    display: block;
  }

  .gara-cform__field input,
  .gara-cform__field textarea {
    display: block;
    box-sizing: border-box;
    width: 100%;
    margin: 0;
    border: 1px solid #d2d2d2;
    border-radius: 0;
    background: #fff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #333;
    box-shadow: none;
    outline: none;
  }

  .gara-cform__field input {
    height: 40px;
    padding: 0 15px;
  }

  .gara-cform__field textarea {
    height: 150px;
    padding: 8px 15px;
    resize: vertical;
  }

  .gara-cform__field input::placeholder,
  .gara-cform__field textarea::placeholder {
    color: #aaa9a9;
  }

  .gara-cform__field input:focus,
  .gara-cform__field textarea:focus {
    border-color: #96c222;
  }

  .gara-cform__honey {
    position: absolute;
    left: -9999px;
    height: 0;
    width: 0;
    opacity: 0;
    pointer-events: none;
  }

  .gara-cform__submit {
    display: inline-block;
    box-sizing: border-box;
    height: 45px;
    margin: 0;
    padding: 13px 29px;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 0;
    background: #96c222;
    font-family: 'PT Sans', Arial, Helvetica, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 17px;
    letter-spacing: normal;
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    text-align: center;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .gara-cform__submit:hover,
  .gara-cform__submit:focus-visible {
    background: #a0ce4e;
    color: #fff;
  }

  .gara-cform__submit:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .gara-cform__status {
    margin: 0 0 20px;
    font-family: 'Open Sans', Arial, Helvetica, sans-serif;
    font-size: 14px;
    color: #96c222;
  }

  .gara-cform__status[data-kind='err'] {
    color: #c51a27;
  }

  .gara-cform__status[data-kind='busy'] {
    color: #747474;
  }

  @media (max-width: 900px) {
    .gara-cform__row--it-split,
    .gara-cform__row--en-center {
      grid-template-columns: 1fr;
    }

    .gara-cform__spacer {
      display: none;
    }

    .gara-cform__title {
      font-size: 36px;
      line-height: 50px;
      text-align: left;
    }
  }
</style>
