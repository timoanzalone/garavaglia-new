---
import { portfolioBase, t, type Locale } from '../i18n';

interface CaseStudy {
  title: string;
  category: string;
  image: string;
  color: string;
  slug: string;
}

interface Props {
  title?: string;
  caseStudies: CaseStudy[];
  lang?: Locale;
}

const {
  caseStudies,
  lang = 'it',
  title = t(lang).relatedCaseStudies,
} = Astro.props;

const base = portfolioBase(lang);
---

<section class="py-16 lg:py-24 bg-white border-t border-gray-200">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-12">
      {title}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        caseStudies.map((study) => (
          <a
            href={`${base}/${study.slug}`}
            class="case-study-item group relative overflow-hidden aspect-[4/3] block"
          >
            <img
              src={study.image}
              alt={study.title}
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div
              class="color-overlay absolute inset-0 flex items-center justify-center translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out"
              style={`background-color: ${study.color};`}
            >
              <h3 class="text-white text-2xl font-bold px-6 text-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-200">
                {study.title}
              </h3>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .case-study-item {
    transition: transform 0.3s ease;
  }

  .case-study-item:hover {
    transform: translateY(-2px);
  }
</style>
