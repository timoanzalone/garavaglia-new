const privacyHref = 'https://www.iubenda.com/privacy-policy/91695126';
const cookieHref = 'https://www.iubenda.com/privacy-policy/91695126/cookie-policy';
---

<footer class="gara-footer">
  <div class="gara-footer__widgets">
    <div class="gara-footer__row">
      <div class="gara-footer__social" aria-label="Social">
        {
          social.map((item) => (
            <a
              class="gara-footer__social-link"
              href={item.href}
              title={item.label}
              aria-label={item.label}
              rel="noopener noreferrer"
              target="_blank"
            >
              <svg
                class="gara-footer__social-icon"
                viewBox="0 0 24 24"
                width="24"
                height="24"
                aria-hidden="true"
                focusable="false"
              >
                <path fill="currentColor" d={item.path} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="gara-footer__copyright">
    <div class="gara-footer__row">
      <p class="gara-footer__notice">
        {labels.footerNotice}
        <a class="gara-footer__badge" href={privacyHref} title={labels.privacyPolicy} target="_blank" rel="noopener noreferrer">
          {labels.privacyPolicy}
        </a>
        <a class="gara-footer__badge" href={cookieHref} title={labels.cookiePolicy} target="_blank" rel="noopener noreferrer">
          {labels.cookiePolicy}
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .gara-footer {
    margin: 0;
    padding: 0;
  }

  .gara-footer__widgets {
    background: #96c222;
    padding: 43px 30px 40px;
  }

  .gara-footer__copyright {
    background: #fff;
    padding: 32px 30px;
  }

  .gara-footer__row {
    max-width: 1280px;
    margin: 0 auto;
  }

  .gara-footer__social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    min-height: 30px; /* WP social wrapper h */
  }

  .gara-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin-bottom: 5.5px;
    color: #fff;
    text-decoration: none;
    line-height: 24px;
  }

  .gara-footer__social-link:hover {
    opacity: 0.85;
  }

  .gara-footer__social-icon {
    display: block;
    width: 24px;
    height: 24px;
  }

  .gara-footer__notice {
    margin: 0;
    padding: 0;
    font-family: var(--gara-font-body);
    font-size: 12px;
    font-weight: 400;
    line-height: 20.4px;
    color: #5a5d62;
  }

  .gara-footer__badge {
    display: inline-block;
    margin-left: 4px;
    padding: 4px 8px;
    border-radius: 3px;
    background: #fff;
    color: rgba(0, 0, 0, 0.65);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    vertical-align: middle;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.15),
      0 1px 1px -1px rgba(0, 0, 0, 0.15);
  }

  .gara-footer__badge:hover {
    color: rgba(0, 0, 0, 0.85);
  }
</style>
