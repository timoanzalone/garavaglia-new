    path: 'M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 0 0 12 7.2zm0 7.9a3.1 3.1 0 1 1 0-6.2 3.1 3.1 0 0 1 0 6.2zM17.5 6.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM12 4.5c2.1 0 2.3 0 3.1.1.8 0 1.3.2 1.6.3.4.2.7.3 1 .7.3.3.5.6.7 1 .1.3.3.8.3 1.6.1.8.1 1 .1 3.1s0 2.3-.1 3.1c0 .8-.2 1.3-.3 1.6-.2.4-.3.7-.7 1-.3.3-.6.5-1 .7-.3.1-.8.3-1.6.3-.8.1-1 .1-3.1.1s-2.3 0-3.1-.1c-.8 0-1.3-.2-1.6-.3-.4-.2-.7-.3-1-.7-.3-.3-.5-.6-.7-1-.1-.3-.3-.8-.3-1.6-.1-.8-.1-1-.1-3.1s0-2.3.1-3.1c0-.8.2-1.3.3-1.6.2-.4.3-.7.7-1 .3-.3.6-.5 1-.7.3-.1.8-.3 1.6-.3.8-.1 1-.1 3.1-.1zM12 3c-2.1 0-2.4 0-3.2.1-.9 0-1.5.2-2 .4-.6.2-1 .5-1.5 1-.4.4-.8.9-1 1.5-.2.5-.4 1.1-.4 2C4 8.6 4 8.9 4 11s0 2.4.1 3.2c0 .9.2 1.5.4 2 .2.6.5 1 1 1.5.4.4.9.8 1.5 1 .5.2 1.1.4 2 .4C9.6 19 9.9 19 12 19s2.4 0 3.2-.1c.9 0 1.5-.2 2-.4.6-.2 1-.5 1.5-1 .4-.4.8-.9 1-1.5.2-.5.4-1.1.4-2 .1-.8.1-1.1.1-3.2s0-2.4-.1-3.2c0-.9-.2-1.5-.4-2-.2-.6-.5-1-1-1.5-.4-.4-.9-.8-1.5-1-.5-.2-1.1-.4-2-.4C14.4 3 14.1 3 12 3z',
  },
  {
    label: 'Vimeo',
    href: 'https://vimeo.com/user17915139',
    path: 'M20.6 7.2c-.1 1.8-1.3 4.3-3.7 7.4-2.5 3.3-4.6 4.9-6.4 4.9-1.1 0-2-.9-2.8-2.8l-1.3-4.7c-.6-2-1.2-3-1.9-3-.2 0-.7.3-1.5.9L2 8.5c1-.9 1.9-1.7 2.8-2.5 1.3-1.1 2.3-1.7 3-1.8 1.6-.2 2.6.9 2.9 3.2.4 2.5.6 4 .7 4.5.3 1.6.7 2.4 1.2 2.4.3 0 .8-.5 1.5-1.6.7-1.1 1.1-1.9 1.2-2.5.1-.9-.3-1.4-1.1-1.4-.4 0-.8.1-1.1.2.8-2.7 2.3-4 4.6-3.9 1.6.1 2.4 1.2 2.3 3.1z',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/company/garavaglia-allestimenti',
    path: 'M6.5 9H3v12h3.5V9zM4.7 3C3.5 3 2.5 4 2.5 5.2S3.5 7.4 4.7 7.4 6.9 6.4 6.9 5.2 5.9 3 4.7 3zM21 13.3c0-3.2-1.7-4.7-4-4.7-1.8 0-2.7 1-3.2 1.9h-.1V9H10.5v12H14v-6c0-1.6.3-3.1 2.2-3.1s2.3 1.7 2.3 3.2V21H22v-7.7z',
  },
