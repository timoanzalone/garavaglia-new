---
/**
 * Footer — measured from garavaglia.test @ 1920, 2026-07-21
 *
 * Widget bar (.fusion-footer-widget-area):
 * - bg #96c222; padding 43px 30px 40px; h ≈ 113
 * - social icons left in 1280 row; white; 24px; margin-left 14px; gap ≈ 18px
 *
 * Copyright (.fusion-footer-copyright-area):
 * - bg #fff; padding 32px 30px; h ≈ 86
 * - text Open Sans 12px / 20.4px / 400 / #5a5d62
 * - "Garavaglia | P.IVA IT03085820961 | 2022 |"
 * - Privacy / Cookie: badge links 11px/700, pad 4px 8px, radius 3px,
 *   color rgba(0,0,0,0.65), bg #fff (iubenda-white style)
 */
import { t, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'it' } = Astro.props;
const labels = t(lang);

