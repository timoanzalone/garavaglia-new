---
/**
 * Hero (flex slider) — measured from garavaglia.test @ 1920, 2026-07-21
 *
 * Measured:
 * - #sliders-container / .flexslider: height 800px (data-slider_height), full width
 * - Slider sits under header (header overlays top; #main starts at 800)
 * - Background: cover, center; no dark overlay
 * - Fade; slideshow_speed 7000; animation_speed 600; no dots/arrows (indicator empty)
 * - Title only on slide 0
 * - .slide-content-container: absolute; top 50%; translateY(-50%);
 *   padding 84px 30px 0; text-align right
 * - .slide-content: max-width 1280px; margin auto
 * - .fusion-title-sc-wrapper: rgba(89,119,2,0.7) (!important home rule);
 *   padding 3px 15px; display inline-block
 * - h2: Raleway 60px / 72px / 400 / #fff; inline-block; text-align right
 */
import { homeSlides } from '../data/site';
import { heroHeading } from '../data/home';
import type { Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'it' } = Astro.props;
const heading = heroHeading[lang];
---

<section id="hero-slider" class="gara-hero" aria-roledescription="carousel">
  <div class="gara-hero__viewport">
    {
      homeSlides.map((slide, index) => (
        <div
          class:list={['gara-hero__slide', index === 0 && 'is-active']}
          data-slide={index}
          style={`background-image: url('${slide.image}');`}
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} / ${homeSlides.length}`}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          {slide.hasHeading && (
            <div class="gara-hero__content">
              <div class="gara-hero__inner">
                <div class="gara-hero__title-wrap">
                  <h2 class="gara-hero__title">{heading}</h2>
                </div>
              </div>
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  /*
   * WP: header overlays slider; #main starts at 800.
   * Pull hero under the 84px header and collapse the gap for following content.
   */
  .gara-hero {
    position: relative;
    top: -84px;
    width: 100%;
    height: 800px;
    margin-bottom: -84px;
    overflow: hidden;
    background: #fff;
  }

  .gara-hero__viewport {
    position: absolute;
    inset: 0;
  }

  .gara-hero__slide {
    position: absolute;
    inset: 0;
    background-position: 50% 50%;
    background-size: cover;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 600ms var(--gara-ease);
    z-index: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .gara-hero__slide {
      transition: none;
    }
  }

  .gara-hero__slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  .gara-hero__content {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    padding: 84px 30px 0;
    text-align: right;
    transform: translateY(-50%);
    z-index: 5;
  }

  .gara-hero__inner {
    max-width: 1280px;
    margin: 0 auto;
    text-align: right;
  }

  .gara-hero__title-wrap {
    display: inline-block;
    padding: 3px 15px;
    line-height: 1;
    background-color: rgba(89, 119, 2, 0.7);
  }

  .gara-hero__title {
    display: inline-block;
    margin: 0;
    padding: 0;
    font-family: var(--gara-font-heading);
    font-size: 60px;
    font-weight: 400;
    line-height: 72px;
    color: #fff;
    text-align: right;
    -webkit-font-smoothing: antialiased;
  }

  @media (max-width: 800px) {
    .gara-hero__title {
      font-size: 32px;
      line-height: 40px;
    }
  }
</style>

<script>
  let heroTimer = 0;
  let heroAbort: AbortController | null = null;

  function initHero() {
    heroAbort?.abort();
    heroAbort = null;
    window.clearInterval(heroTimer);
    heroTimer = 0;

    const root = document.getElementById('hero-slider');
    if (!root) return;

    const slides = [...root.querySelectorAll<HTMLElement>('.gara-hero__slide')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let paused = false;
    const abort = new AbortController();
    heroAbort = abort;

    function show(index: number) {
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      current = index;
    }

    function next() {
      show((current + 1) % slides.length);
    }

    function stop() {
      window.clearInterval(heroTimer);
      heroTimer = 0;
    }

    function start() {
      if (reduceMotion || paused || document.hidden || slides.length < 2) return;
      stop();
      heroTimer = window.setInterval(next, 7000);
    }

    if (!reduceMotion) {
      root.addEventListener(
        'pointerenter',
        () => {
          paused = true;
          stop();
        },
        { signal: abort.signal },
      );
      root.addEventListener(
        'pointerleave',
        () => {
          paused = false;
          start();
        },
        { signal: abort.signal },
      );
      document.addEventListener(
        'visibilitychange',
        () => {
          if (document.hidden) stop();
          else start();
        },
        { signal: abort.signal },
      );
      start();
    }
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>
