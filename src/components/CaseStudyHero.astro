---
import { t, type Locale } from '../i18n';

interface Props {
  title: string;
  subtitle: string;
  category: string;
  categoryColor: string;
  heroImage: string;
  place?: string;
  client?: string;
  lang?: Locale;
}

const {
  title,
  subtitle,
  category,
  categoryColor,
  heroImage,
  place,
  client,
  lang = 'it',
} = Astro.props;
const labels = t(lang);
---

<!-- Hero Section with Fixed Background -->
<section class="hero-section relative min-h-[60vh] lg:min-h-[70vh] flex items-end overflow-hidden">
  <!-- Fixed Background Image -->
  <div 
    class="hero-bg absolute inset-0 bg-cover bg-center bg-fixed"
    style={`background-image: url('${heroImage}');`}
  ></div>
  
  <!-- Overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/40 to-transparent"></div>
  
  <!-- Content -->
  <div class="relative z-10 w-full py-16 lg:py-24">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <div class="max-w-4xl">
        <span 
          class="inline-block text-white text-sm font-bold px-4 py-2 rounded mb-6"
          style={`background-color: ${categoryColor};`}
        >
          {category}
        </span>
        
        <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6 leading-tight drop-shadow-lg">
          {title}
        </h1>
        
        {subtitle && (
          <p class="text-xl text-white/90 mb-8 leading-relaxed drop-shadow-md">
            {subtitle}
          </p>
        )}
      </div>
    </div>
  </div>
</section>

<!-- Project Details Section -->
{(place || client) && (
  <section class="py-8 bg-white border-b border-gray-200">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <div class="max-w-4xl">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-base">
          {place && (
            <p class="text-gray-900">
              <strong class="font-semibold">{labels.place}</strong> {place}
            </p>
          )}
          {client && (
            <p class="text-gray-900">
              <strong class="font-semibold">{labels.client}</strong> {client}
            </p>
          )}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .hero-section {
    background-color: #1f2937;
  }

  .hero-bg {
    will-change: transform;
  }

  @media (max-width: 768px) {
    .hero-bg {
      background-attachment: scroll;
    }
  }
</style>
