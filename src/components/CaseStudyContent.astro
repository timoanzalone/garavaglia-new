---
interface Props {
  content?: string;
}

const { content } = Astro.props;
---

<section class="py-12 lg:py-16 bg-white">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="max-w-4xl">
      <div class="prose prose-lg max-w-none">
        <slot />
        {content && <div set:html={content} />}
      </div>
    </div>
  </div>
</section>

<style>
  .prose {
    color: #4b5563;
    line-height: 1.75;
  }
  
  .prose p {
    margin-bottom: 1.5rem;
  }
  
  .prose strong {
    color: #1f2937;
    font-weight: 600;
  }
  
  .prose h2 {
    color: #1f2937;
    font-size: 2rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
  }
  
  .prose h3 {
    color: #1f2937;
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
</style>
