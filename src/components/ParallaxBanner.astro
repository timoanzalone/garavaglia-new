---
/**
 * Area banner — measured from garavaglia.test @ 1920, 2026-07-21
 * Light refresh: subtle hover scale + brightness on the background.
 *
 * Measured (5 home banners, all fusion-parallax-none):
 * - Full-bleed bg: cover, no-repeat; no dark overlay; no parallax
 * - Section pad L/R 30px; margin-bottom 40px
 * - Per-banner pad T/B + background-position (see site.ts)
 * - Logo in 1280px row, left-aligned, natural px size
 * - Height = pad-top + logo-height + pad-bottom
 */
interface Props {
  backgroundImage: string;
  backgroundPosition?: string;
  padding?: string;
  logo: string;
  logoAlt: string;
  logoWidth: number;
  logoHeight: number;
  linkUrl: string;
}

const {
  backgroundImage,
  backgroundPosition = 'center center',
  padding = '175px 30px',
  logo,
  logoAlt,
  logoWidth,
  logoHeight,
  linkUrl,
} = Astro.props;
---

<a
  href={linkUrl}
  class="gara-banner"
  style={`--gara-banner-bg: url('${backgroundImage}'); --gara-banner-pos: ${backgroundPosition}; padding: ${padding};`}
>
  <span class="gara-banner__bg" aria-hidden="true"></span>
  <div class="gara-banner__row">
    <img
      class="gara-banner__logo"
      src={logo}
      alt={logoAlt}
      width={logoWidth}
      height={logoHeight}
      loading="lazy"
    />
  </div>
</a>

<style>
  .gara-banner {
    position: relative;
    display: block;
    width: 100%;
    margin: 0 0 40px;
    background-color: #fff;
    text-decoration: none;
    box-sizing: border-box;
    overflow: hidden;
  }

  .gara-banner__bg {
    position: absolute;
    inset: 0;
    background-image: var(--gara-banner-bg);
    background-position: var(--gara-banner-pos);
    background-size: cover;
    background-repeat: no-repeat;
    transition:
      transform var(--gara-duration) var(--gara-ease),
      filter var(--gara-duration) var(--gara-ease);
    z-index: 0;
  }

  .gara-banner:hover .gara-banner__bg,
  .gara-banner:focus-visible .gara-banner__bg {
    transform: scale(1.03);
    filter: brightness(1.06);
  }

  .gara-banner__row {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
  }

  .gara-banner__logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 800px) {
    .gara-banner {
      padding-top: 80px !important;
      padding-bottom: 80px !important;
    }

    .gara-banner__logo {
      max-width: 260px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gara-banner__bg {
      transition: none;
    }

    .gara-banner:hover .gara-banner__bg,
    .gara-banner:focus-visible .gara-banner__bg {
      transform: none;
      filter: none;
    }
  }
</style>
